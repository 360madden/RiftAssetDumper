{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rift-modding.local/schemas/post50-promotion-readiness-status-v1.schema.json",
  "title": "Post-50 promotion readiness status v1",
  "description": "Machine-readable post-50 parser/export promotion readiness gate summary. V1 is intentionally locked not-ready.",
  "type": "object",
  "required": [
    "SchemaVersion",
    "CandidateOnly",
    "ReportRoot",
    "OverallReady",
    "ParserExportPromotionAllowed",
    "SchemaBackedReportCount",
    "TotalReportCount",
    "ReportFreshness",
    "RecommendedLane",
    "GateRows",
    "Blockers",
    "Decision",
    "NextAction"
  ],
  "properties": {
    "SchemaVersion": {
      "const": "post50-promotion-readiness-status/v1"
    },
    "CandidateOnly": {
      "const": true
    },
    "ReportRoot": {
      "type": "string",
      "minLength": 1
    },
    "OverallReady": {
      "const": false
    },
    "ParserExportPromotionAllowed": {
      "const": false
    },
    "SchemaBackedReportCount": {
      "type": "integer",
      "minimum": 0
    },
    "TotalReportCount": {
      "type": "integer",
      "minimum": 0
    },
    "ReportFreshness": {
      "$ref": "#/$defs/reportFreshness"
    },
    "RecommendedLane": {
      "type": "string"
    },
    "GateRows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gateRow"
      }
    },
    "Blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "Deferred": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "PromotedFamilies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Family": {
            "type": "string"
          },
          "MeshSize": {
            "type": "integer"
          },
          "OBJsExported": {
            "type": "integer"
          },
          "Evidence": {
            "type": "string"
          },
          "ExportPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "Note": {
            "type": "string"
          }
        },
        "required": [
          "Family",
          "MeshSize",
          "OBJsExported",
          "Evidence"
        ],
        "additionalProperties": true
      }
    },
    "Decision": {
      "type": "string",
      "minLength": 1
    },
    "NextAction": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "reportFreshness": {
      "type": "object",
      "required": [
        "ExistingReportCount",
        "MissingReportCount",
        "UnreadableReportCount",
        "OldestReportMtimeUtc",
        "NewestReportMtimeUtc",
        "MtimeRangeSeconds",
        "OldestReportKeys",
        "NewestReportKeys",
        "OlderThanNewestKeys",
        "MissingOrUnreadableKeys"
      ],
      "properties": {
        "ExistingReportCount": {
          "type": "integer",
          "minimum": 0
        },
        "MissingReportCount": {
          "type": "integer",
          "minimum": 0
        },
        "UnreadableReportCount": {
          "type": "integer",
          "minimum": 0
        },
        "OldestReportMtimeUtc": {
          "type": "string"
        },
        "NewestReportMtimeUtc": {
          "type": "string"
        },
        "MtimeRangeSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "OldestReportKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "NewestReportKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "OlderThanNewestKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "MissingOrUnreadableKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "gateRow": {
      "type": "object",
      "required": [
        "Gate",
        "RequiredForPromotion",
        "Pass",
        "Evidence",
        "CurrentValue"
      ],
      "properties": {
        "Gate": {
          "type": "string",
          "minLength": 1
        },
        "RequiredForPromotion": {
          "type": "boolean"
        },
        "Pass": {
          "type": "boolean"
        },
        "Evidence": {
          "type": "string"
        },
        "CurrentValue": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
