{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rift-modding.local/schemas/live-memory-step49-status-v1.schema.json",
  "title": "50-step plan Step 49 live float-cluster scan status",
  "type": "object",
  "required": [
    "SchemaVersion",
    "CandidateOnly",
    "Step",
    "Provider",
    "ProbeLabel",
    "ProbeKind",
    "LiveReadApproved",
    "LiveReadExecuted",
    "HitCount",
    "MaxHitsReached",
    "RiftReaderGenericTripletScanAvailable",
    "RiftReaderGenericTripletScanCommand",
    "RiftReaderGenericTripletScanCommit",
    "BoundedTripletProbeExecuted",
    "BoundedTripletProbeRegionBase",
    "BoundedTripletProbeRegionSize",
    "BoundedTripletPositiveControlHitCount",
    "BoundedExpectedStaticV0HitCount",
    "BoundedExpectedStaticBatchExecuted",
    "BoundedExpectedStaticBatchRegionCount",
    "BoundedExpectedStaticBatchVertexCount",
    "BoundedExpectedStaticBatchScanCount",
    "BoundedExpectedStaticBatchTimedOutCount",
    "BoundedExpectedStaticBatchHitCount",
    "ClusterConfirmed",
    "Step49Complete",
    "GeneratedReportPolicy",
    "ParserExportPromotionAllowed",
    "NextAction"
  ],
  "properties": {
    "SchemaVersion": { "const": "live-memory-step49-status/v1" },
    "CandidateOnly": { "const": true },
    "Step": { "const": 49 },
    "Provider": { "const": "RiftReader.Reader" },
    "ProbeLabel": { "const": "stage5_step49_mesh297_v0_x_float32" },
    "ProbeKind": { "const": "single-float-probe" },
    "LiveReadApproved": { "type": "boolean" },
    "LiveReadExecuted": { "type": "boolean" },
    "HitCount": { "type": "integer", "minimum": 0 },
    "MaxHitsReached": { "type": "boolean" },
    "RiftReaderGenericTripletScanAvailable": { "type": "boolean" },
    "RiftReaderGenericTripletScanCommand": { "const": "--scan-float-triplet <x,y,z> --scan-region-base <address> --scan-region-size <bytes>" },
    "RiftReaderGenericTripletScanCommit": { "type": "string", "minLength": 7 },
    "BoundedTripletProbeExecuted": { "type": "boolean" },
    "BoundedTripletProbeRegionBase": { "type": "string", "pattern": "^0x[0-9A-Fa-f]+$" },
    "BoundedTripletProbeRegionSize": { "type": "integer", "minimum": 1 },
    "BoundedTripletPositiveControlHitCount": { "type": "integer", "minimum": 0 },
    "BoundedExpectedStaticV0HitCount": { "type": "integer", "minimum": 0 },
    "BoundedExpectedStaticBatchExecuted": { "type": "boolean" },
    "BoundedExpectedStaticBatchRegionCount": { "type": "integer", "minimum": 0 },
    "BoundedExpectedStaticBatchVertexCount": { "type": "integer", "minimum": 0 },
    "BoundedExpectedStaticBatchScanCount": { "type": "integer", "minimum": 0 },
    "BoundedExpectedStaticBatchTimedOutCount": { "type": "integer", "minimum": 0 },
    "BoundedExpectedStaticBatchHitCount": { "type": "integer", "minimum": 0 },
    "ClusterConfirmed": { "const": false },
    "Step49Complete": { "const": false },
    "GeneratedReportPolicy": { "const": "ignored under Exports/discovery-plan/stage5-live" },
    "ParserExportPromotionAllowed": { "const": false },
    "NextAction": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
