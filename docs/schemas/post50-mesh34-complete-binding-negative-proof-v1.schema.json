{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rift-modding.local/schemas/post50-mesh34-complete-binding-negative-proof-v1.schema.json",
  "title": "Post-50 mesh34 complete-binding negative proof v1",
  "description": "Candidate-only proof report showing current meshSize=329 mesh#34 examples lack complete geometry binding for parser/export promotion.",
  "type": "object",
  "required": [
    "SchemaVersion",
    "CandidateOnly",
    "SourceReport",
    "MeshSize",
    "MeshBlock",
    "PrimaryStream",
    "ExtraStream",
    "ProofRows",
    "Aggregate",
    "ParserExportPromotionAllowed",
    "Interpretation",
    "NextAction"
  ],
  "properties": {
    "SchemaVersion": { "const": "post50-mesh34-complete-binding-negative-proof/v1" },
    "CandidateOnly": { "const": true },
    "SourceReport": { "type": "string", "minLength": 1 },
    "MeshSize": { "const": 329 },
    "MeshBlock": { "const": 34 },
    "PrimaryStream": { "const": "@212/#28" },
    "ExtraStream": { "const": "@304/#57" },
    "ProofRows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/proofRow" }
    },
    "Aggregate": { "$ref": "#/$defs/aggregate" },
    "ParserExportPromotionAllowed": { "const": false },
    "Interpretation": { "type": "string", "minLength": 1 },
    "NextAction": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "proofRow": {
      "type": "object",
      "required": [
        "Pair",
        "Id",
        "PrimaryStream",
        "PrimaryVectorCount",
        "ExtraStream",
        "ExtraVectorCount",
        "ExtraPayloadRemainder",
        "Mesh34NormalStream",
        "Mesh34NormalVectorCount",
        "Mesh34AttributeSetCount",
        "Mesh34UvStreamCount",
        "SharedPrimaryStream",
        "HasCompleteAttributeSet",
        "HasUvStream",
        "CompleteGeometryBindingProven",
        "NegativeBindingProven",
        "Decision"
      ],
      "properties": {
        "Pair": { "type": "string" },
        "Id": { "type": "string", "minLength": 1 },
        "PrimaryStream": { "type": "string" },
        "PrimaryVectorCount": { "type": "integer", "minimum": 0 },
        "ExtraStream": { "type": "string" },
        "ExtraVectorCount": { "type": "integer", "minimum": 0 },
        "ExtraPayloadRemainder": { "type": "integer", "minimum": 0 },
        "Mesh34NormalStream": { "type": "string" },
        "Mesh34NormalVectorCount": { "type": "integer", "minimum": 0 },
        "Mesh34AttributeSetCount": { "type": "integer", "minimum": 0 },
        "Mesh34UvStreamCount": { "type": "integer", "minimum": 0 },
        "SharedPrimaryStream": { "type": "boolean" },
        "HasCompleteAttributeSet": { "type": "boolean" },
        "HasUvStream": { "type": "boolean" },
        "CompleteGeometryBindingProven": { "type": "boolean" },
        "NegativeBindingProven": { "type": "boolean" },
        "Decision": { "type": "string" }
      },
      "additionalProperties": false
    },
    "aggregate": {
      "type": "object",
      "required": [
        "ExampleCount",
        "CompleteGeometryBindingCount",
        "NegativeBindingCount",
        "AllRowsSharedPrimaryAt212Block28",
        "AllRowsExtraAt304Block57",
        "AllRowsLackCompleteAttributeSet",
        "AllRowsLackUvStreams",
        "AllRowsNegativeBinding",
        "ParserExportPromotionAllowed",
        "ExportReady",
        "Blockers",
        "Decision"
      ],
      "properties": {
        "ExampleCount": { "type": "integer", "minimum": 1 },
        "CompleteGeometryBindingCount": { "type": "integer", "minimum": 0 },
        "NegativeBindingCount": { "type": "integer", "minimum": 0 },
        "AllRowsSharedPrimaryAt212Block28": { "type": "boolean" },
        "AllRowsExtraAt304Block57": { "type": "boolean" },
        "AllRowsLackCompleteAttributeSet": { "type": "boolean" },
        "AllRowsLackUvStreams": { "type": "boolean" },
        "AllRowsNegativeBinding": { "type": "boolean" },
        "ParserExportPromotionAllowed": { "const": false },
        "ExportReady": { "const": false },
        "Blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "Decision": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
