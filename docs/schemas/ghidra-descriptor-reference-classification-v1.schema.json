{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rift-modding.local/schemas/ghidra-descriptor-reference-classification-v1.schema.json",
  "title": "Ghidra descriptor reference classification report",
  "description": "Candidate-only classification of Ghidra references to descriptor data addresses.",
  "type": "object",
  "required": [
    "SchemaVersion",
    "CandidateOnly",
    "FieldOrderPromoted",
    "ParserExportPromotionAllowed",
    "programName",
    "imageBase",
    "byteCountRequested",
    "maxRefsPerField",
    "fieldCount",
    "fields",
    "totalReferenceCount",
    "totalCapturedReferenceCount",
    "fieldWithReferencesCount",
    "readReferenceCount",
    "writeReferenceCount",
    "dataReferenceCount",
    "addressLikeReferenceCount",
    "uniqueReferencingFunctionCount",
    "interpretation"
  ],
  "properties": {
    "SchemaVersion": { "const": "ghidra-descriptor-reference-classification/v1" },
    "CandidateOnly": { "const": true },
    "FieldOrderPromoted": { "const": false },
    "ParserExportPromotionAllowed": { "const": false },
    "programName": { "type": "string" },
    "imageBase": { "type": "string" },
    "byteCountRequested": { "type": "integer", "minimum": 1, "maximum": 64 },
    "maxRefsPerField": { "type": "integer", "minimum": 1, "maximum": 512 },
    "fieldCount": { "type": "integer", "minimum": 0 },
    "fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/field" }
    },
    "totalReferenceCount": { "type": "integer", "minimum": 0 },
    "totalCapturedReferenceCount": { "type": "integer", "minimum": 0 },
    "fieldWithReferencesCount": { "type": "integer", "minimum": 0 },
    "readReferenceCount": { "type": "integer", "minimum": 0 },
    "writeReferenceCount": { "type": "integer", "minimum": 0 },
    "dataReferenceCount": { "type": "integer", "minimum": 0 },
    "addressLikeReferenceCount": { "type": "integer", "minimum": 0 },
    "uniqueReferencingFunctionCount": { "type": "integer", "minimum": 0 },
    "interpretation": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "required": [
        "field",
        "address",
        "addressValid",
        "memoryBacked",
        "memoryBlockName",
        "memoryBlockStart",
        "memoryBlockEnd",
        "memoryBlockSize",
        "memoryBlockInitialized",
        "memoryBlockLoaded",
        "memoryBlockRead",
        "memoryBlockWrite",
        "memoryBlockExecute",
        "memoryBlockVolatile",
        "memoryBlockArtificial",
        "memoryBlockType",
        "memoryBlockSourceName",
        "byteCountRead",
        "bytes",
        "symbolCount",
        "symbols",
        "referenceCountTo",
        "capturedReferenceCount",
        "referencesTruncated",
        "readReferenceCount",
        "writeReferenceCount",
        "dataReferenceCount",
        "addressLikeReferenceCount",
        "flowReferenceCount",
        "referencingFunctionCount",
        "references"
      ],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "pattern": "^[0-9a-fA-F]+$" },
        "addressValid": { "type": "boolean" },
        "memoryBacked": { "type": "boolean" },
        "memoryBlockName": { "type": "string" },
        "memoryBlockStart": { "type": "string" },
        "memoryBlockEnd": { "type": "string" },
        "memoryBlockSize": { "type": "integer", "minimum": 0 },
        "memoryBlockInitialized": { "type": "boolean" },
        "memoryBlockLoaded": { "type": "boolean" },
        "memoryBlockRead": { "type": "boolean" },
        "memoryBlockWrite": { "type": "boolean" },
        "memoryBlockExecute": { "type": "boolean" },
        "memoryBlockVolatile": { "type": "boolean" },
        "memoryBlockArtificial": { "type": "boolean" },
        "memoryBlockType": { "type": "string" },
        "memoryBlockSourceName": { "type": "string" },
        "byteCountRead": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "string", "pattern": "^(?:[0-9a-f]{2}(?: [0-9a-f]{2})*)?$" },
        "byteReadError": { "type": "string" },
        "symbolCount": { "type": "integer", "minimum": 0 },
        "symbols": {
          "type": "array",
          "items": { "$ref": "#/$defs/symbol" }
        },
        "referenceCountTo": { "type": "integer", "minimum": 0 },
        "capturedReferenceCount": { "type": "integer", "minimum": 0 },
        "referencesTruncated": { "type": "boolean" },
        "readReferenceCount": { "type": "integer", "minimum": 0 },
        "writeReferenceCount": { "type": "integer", "minimum": 0 },
        "dataReferenceCount": { "type": "integer", "minimum": 0 },
        "addressLikeReferenceCount": { "type": "integer", "minimum": 0 },
        "flowReferenceCount": { "type": "integer", "minimum": 0 },
        "referencingFunctionCount": { "type": "integer", "minimum": 0 },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" }
        }
      },
      "additionalProperties": false
    },
    "symbol": {
      "type": "object",
      "required": ["name", "type", "source", "primary", "dynamic"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "source": { "type": "string" },
        "primary": { "type": "boolean" },
        "dynamic": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": [
        "fromAddress",
        "toAddress",
        "operandIndex",
        "referenceType",
        "referenceKind",
        "source",
        "primary",
        "data",
        "read",
        "write",
        "flow",
        "call",
        "jump",
        "computed",
        "indirect",
        "memoryReference",
        "offsetReference",
        "shiftedReference",
        "externalReference",
        "operandReference",
        "mnemonicReference"
      ],
      "properties": {
        "fromAddress": { "type": "string" },
        "toAddress": { "type": "string" },
        "operandIndex": { "type": "integer" },
        "referenceType": { "type": "string" },
        "referenceKind": {
          "enum": ["read-write", "read", "write", "address-like-data", "call", "flow", "other"]
        },
        "source": { "type": "string" },
        "primary": { "type": "boolean" },
        "data": { "type": "boolean" },
        "read": { "type": "boolean" },
        "write": { "type": "boolean" },
        "flow": { "type": "boolean" },
        "call": { "type": "boolean" },
        "jump": { "type": "boolean" },
        "computed": { "type": "boolean" },
        "indirect": { "type": "boolean" },
        "memoryReference": { "type": "boolean" },
        "offsetReference": { "type": "boolean" },
        "shiftedReference": { "type": "boolean" },
        "externalReference": { "type": "boolean" },
        "operandReference": { "type": "boolean" },
        "mnemonicReference": { "type": "boolean" },
        "fromFunction": { "type": "string" },
        "fromFunctionEntry": { "type": "string" },
        "fromFunctionSignature": { "type": "string" },
        "instructionAddress": { "type": "string" },
        "instructionMnemonic": { "type": "string" },
        "instructionText": { "type": "string" },
        "instructionBytes": { "type": "string" },
        "instructionByteError": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
