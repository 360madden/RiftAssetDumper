{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.riftassetdumper/schemas/struct-layout-catalog-v1.schema.json",
  "title": "RIFT Struct Layout Catalog v1",
  "description": "Phase 3 struct layout mapping: field-level offsets, types, and confidence for data structures accessed via ModRM [base+disp32] memory operations. Derived from empirical ModRM byte-scan evidence and Ghidra FunctionSiteSurvey decompilation.",
  "type": "object",
  "required": [
    "SchemaVersion",
    "BinaryTarget",
    "ExtractedAt",
    "EvidenceSources",
    "GhidraFindings",
    "Structs"
  ],
  "properties": {
    "SchemaVersion": { "const": "struct-layout-catalog/v1" },
    "BinaryTarget": {
      "type": "string",
      "description": "Filename of the target PE binary (e.g., rift_x64.exe)."
    },
    "ImageBase": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]+$",
      "description": "Image base address used for RVA-to-VA translation."
    },
    "ExtractedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of catalog synthesis."
    },
    "EvidenceSources": {
      "type": "object",
      "description": "List of evidence inputs used to derive this catalog.",
      "properties": {
        "ModRMScanSchema": { "type": "string" },
        "ModRMScanPath": { "type": "string" },
        "ModRMTotalHits": { "type": "integer", "minimum": 0 },
        "SignatureCatalogSchema": { "type": "string" },
        "SignatureCatalogPath": { "type": "string" },
        "GhidraReports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["address", "functionName"],
            "properties": {
              "address": { "type": "string" },
              "functionName": { "type": "string" },
              "functionSize": { "type": "integer", "minimum": 0 },
              "decompileCompleted": { "type": "boolean" },
              "decompileLines": { "type": "integer", "minimum": 0 },
              "callers": { "type": "integer", "minimum": 0 },
              "callsFrom": { "type": "integer", "minimum": 0 },
              "dataRefs": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "GhidraFindings": {
      "type": "object",
      "description": "Corrections to earlier handoff analysis based on Ghidra decompilation.",
      "properties": {
        "PreviousCallback0x320": { "type": "string" },
        "PreviousCallback0x328": { "type": "string" },
        "PropertyWalkerArchitecture": { "type": "string" },
        "ActualAccessPattern": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Structs": {
      "type": "array",
      "items": { "$ref": "#/$defs/struct" },
      "minItems": 1
    }
  },
  "$defs": {
    "struct": {
      "type": "object",
      "required": [
        "Name",
        "Description",
        "EvidenceSource",
        "Fields"
      ],
      "properties": {
        "Name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Human-readable struct name (e.g., LocalPlayer, GameEntity)."
        },
        "Description": {
          "type": "string",
          "description": "What this struct represents and how it's accessed."
        },
        "EvidenceSource": {
          "type": "string",
          "enum": ["modrm-memory-access-scan/v1", "ghidra-function-site-survey/v1", "riftreader-known-offsets", "manual-static-analysis"],
          "description": "Primary evidence source for this struct layout."
        },
        "BaseRegisters": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "description": "Distribution of base registers (RBX, RCX, etc.) accessing this struct."
        },
        "TotalModRMHits": {
          "type": "integer",
          "minimum": 0,
          "description": "Total ModRM [base+disp32] hits across all fields in this struct."
        },
        "SignatureAnchors": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Phase 2 signature anchor names that resolve to this struct."
        },
        "Fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": ["Offset", "OffsetHex", "Name", "Type", "Confidence"],
      "properties": {
        "Offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Byte offset from struct base (decimal)."
        },
        "OffsetHex": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]+$",
          "description": "Byte offset from struct base (hex)."
        },
        "Name": {
          "type": "string",
          "description": "Field name (e.g., pos_x, facing_x, turn_rate)."
        },
        "Type": {
          "type": "string",
          "enum": ["float32", "int32", "uint32", "pointer64", "vec3_float32", "unknown"],
          "description": "Field data type."
        },
        "Confidence": {
          "type": "string",
          "enum": ["confirmed", "inferred", "tentative"],
          "description": "confirmed = multiple independent evidence sources; inferred = single strong source; tentative = speculative"
        },
        "ModRMHitCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of ModRM [base+disp32] hits for this specific offset."
        },
        "RiftReaderField": {
          "type": "string",
          "description": "Corresponding RiftReader field name if known."
        },
        "Notes": {
          "type": "string",
          "description": "Additional context (e.g., why low hit count, Y-is-derived hypothesis)."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
