{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rift-modding.dev/schemas/binary-signatures-v1.schema.json",
  "title": "Binary Signatures v1",
  "description": "Schema for the Rift x64 binary signature database consumed by RiftReader and other runtime tools. Covers anchor signatures, Lua API tracing, unit registry mapping, struct layouts, and integration pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SchemaVersion",
    "BinaryTarget",
    "ImageBase",
    "ExtractedAt",
    "WildcardPolicy",
    "CandidateOnly",
    "Provenance",
    "Anchors",

    "Summary"
  ],
  "properties": {
    "SchemaVersion": {
      "const": "binary-signatures/v1",
      "description": "Schema identifier and version"
    },
    "BinaryTarget": {
      "type": "string",
      "description": "Filename of the target PE binary"
    },
    "BinaryVersion": {
      "type": "object",
      "description": "PE metadata for the target binary at extraction time",
      "additionalProperties": true
    },
    "ImageBase": {
      "type": "string",
      "description": "Preferred image base as hex string (e.g. '0x140000000')"
    },
    "TextSection": {
      "type": "object",
      "description": ".text section metadata",
      "additionalProperties": true
    },
    "ExtractedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of extraction"
    },
    "WildcardPolicy": {
      "type": "string",
      "description": "Rules governing which bytes are masked as wildcards in signature hex"
    },
    "CandidateOnly": {
      "type": "boolean",
      "description": "True if signatures are preliminary and not yet validated"
    },
    "Provenance": {
      "type": "object",
      "description": "Discovery and validation metadata for the entire database",
      "additionalProperties": true,
      "properties": {
        "GhidraFindings": {
          "type": "object",
          "description": "Narrative corrections from Ghidra decompilation",
          "additionalProperties": false,
          "properties": {
            "PreviousCallback0x320": {"type": "string"},
            "PreviousCallback0x328": {"type": "string"},
            "PropertyWalkerArchitecture": {"type": "string"},
            "ActualAccessPattern": {"type": "string"}
          }
        }
      }
    },
    "Anchors": {
      "type": "array",
      "description": "Byte-signature anchors used to locate code/data in the binary",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "Name",
          "StabilityTier",
          "Description",
          "SignatureHex",
          "SignatureLength",
          "WildcardCount",
          "UniquenessVerified",
          "DiscoveryMethod"
        ],
        "properties": {
          "Name": {
            "type": "string",
            "description": "Human-readable anchor identifier"
          },
          "StabilityTier": {
            "type": "integer",
            "enum": [1, 2, 3],
            "description": "1 = maximally stable (addresses zeroed), 2 = stable with minor risk, 3 = volatile"
          },
          "Description": {
            "type": "string",
            "description": "What this anchor represents"
          },
          "SignatureHex": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f ?]+$",
            "description": "Space-separated hex bytes. ?? = wildcard byte"
          },
          "SignatureLength": {
            "type": "integer",
            "minimum": 1,
            "description": "Total byte length including wildcards"
          },
          "WildcardCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of wildcard bytes in the signature"
          },
          "UniquenessVerified": {
            "type": "boolean",
            "description": "True if the signature matches exactly once in the binary"
          },
          "DiscoveryMethod": {
            "type": "string",
            "description": "Which discovery pipeline produced this anchor"
          },
          "PointerResolution": {
            "type": "object",
            "description": "How to resolve the final pointer from this anchor",
            "additionalProperties": false,
            "properties": {
              "Method": {"type": "string"},
              "InstructionOffsetToPointer": {"type": "integer", "minimum": 0},
              "PointerByteCount": {"type": "integer", "minimum": 0},
              "Notes": {"type": "string"}
            }
          },
          "EntryVA": {
            "type": ["string", "null"],
            "description": "Virtual address of the matched pattern (hex string)"
          },
          "ClusterVA": {
            "type": ["string", "null"],
            "description": "VA of the cluster centroid for modrm-discovered anchors"
          },
          "RelatedStrings": {
            "type": "object",
            "description": "Related string VAs discovered near this anchor",
            "additionalProperties": true
          },
          "StructLayout": {
            "oneOf": [
              {
                "type": "object",
                "description": "Embedded struct layout with field definitions",
                "additionalProperties": false,
                "required": ["Description", "Fields"],
                "properties": {
                  "Description": {"type": "string"},
                  "Fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["Offset", "OffsetHex", "Name", "Type", "Confidence"],
                      "properties": {
                        "Offset": {"type": "integer"},
                        "OffsetHex": {"type": "string"},
                        "Name": {"type": "string"},
                        "Type": {"type": "string"},
                        "Confidence": {"type": "string"},
                        "RiftReaderField": {"type": "string"},
                        "ModRMHitCount": {"type": "integer", "minimum": 0},
                        "Notes": {"type": "string"}
                      }
                    }
                  },
                  "BaseRegisters": {"type": "object"},
                  "TotalModRMHits": {"type": "integer", "minimum": 0}
                }
              },
              {
                "type": "string",
                "description": "Reference to a named struct layout in UnitRegistry"
              },
              {
                "type": "null"
              }
            ]
          },
          "HitCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of ModRM hits observed for this signature cluster"
          },
          "PlayerCoordinateScore": {
            "type": "number",
            "minimum": 0,
            "description": "Heuristic score indicating likelihood this anchor relates to player coordinates"
          }
        }
      }
    },
    "LuaApiTracing": {
      "type": "object",
      "description": "Lua API object-discovery tracing results",
      "additionalProperties": true
    },
    "UnitRegistry": {
      "type": "object",
      "description": "Unit registry and object structure mapping",
      "additionalProperties": true
    },
    "IntegrationSequence": {
      "type": "object",
      "description": "Five-step integration pipeline from scan to runtime read",
      "additionalProperties": true
    },
    "ABITransaction": {
      "type": "object",
      "description": "Calling convention and ABI details for the handler",
      "additionalProperties": true
    },
    "ScanStrategy": {
      "type": "object",
      "description": "Implementation guidance for Reloaded.Memory.Sigscan and ASLR handling",
      "additionalProperties": true
    },
    "FallbackStrategies": {
      "type": "array",
      "description": "Ordered fallback strategies when primary signatures break",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["Priority", "Scenario", "Strategy"],
        "properties": {
          "Priority": {"type": "integer", "minimum": 1},
          "Scenario": {"type": "string"},
          "Strategy": {"type": "string"}
        }
      }
    },
    "Summary": {
      "type": "object",
      "description": "Aggregate statistics for the database",
      "additionalProperties": true
    }
  },
  "$defs": {
    "stringLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["VA", "Section"],
      "properties": {
        "VA": {"type": "string"},
        "Section": {"type": "string"}
      }
    },
    "structField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Offset", "Type", "Name", "Confidence"],
      "properties": {
        "Offset": {"type": "string", "pattern": "^0x[0-9A-Fa-f]+$"},
        "Type": {"type": "string"},
        "Name": {"type": "string"},
        "Value": {"type": "string"},
        "Confidence": {"type": "string", "enum": ["high", "medium", "low", "inferred", "confirmed"]},
        "Evidence": {"type": "string"}
      }
    },
    "coordinateField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Offset", "Type", "Name", "ModRMHits", "Confidence", "RiftReaderField"],
      "properties": {
        "Offset": {"type": "string", "pattern": "^0x[0-9A-Fa-f]+$"},
        "Type": {"type": "string"},
        "Name": {"type": "string"},
        "ModRMHits": {"type": "integer", "minimum": 0},
        "Confidence": {"type": "string", "enum": ["high", "medium", "low", "inferred", "confirmed"]},
        "RiftReaderField": {"type": "string"}
      }
    },
    "integrationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Step", "Name", "Description", "Method", "ResultType", "Output"],
      "properties": {
        "Step": {"type": "integer", "minimum": 1, "maximum": 5},
        "Name": {"type": "string"},
        "Description": {"type": "string"},
        "Method": {"type": "string"},
        "Pattern": {"type": "object", "additionalProperties": false},
        "ResultType": {"type": "string"},
        "Output": {"type": "object", "additionalProperties": false}
      }
    }
  }
}
