{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.riftassetdumper/schemas/nidatastream-descriptor-proof-status-v1.schema.json",
  "title": "NiDataStream descriptor proof status v1",
  "description": "Candidate-only FunctionSiteSurvey evidence status for NiDataStream descriptor helper/builders.",
  "type": "object",
  "required": [
    "SchemaVersion",
    "CandidateOnly",
    "FieldOrderPromoted",
    "RequiredTargetCount",
    "EvidenceReadyCount",
    "AllRequiredEvidenceReady",
    "Targets",
    "CandidateFieldMap",
    "DescriptorRecordIndexProof",
    "DescriptorHelperArgumentUseProof",
    "NextAction"
  ],
  "properties": {
    "SchemaVersion": { "const": "nidatastream-descriptor-proof-status/v1" },
    "CandidateOnly": { "const": true },
    "FieldOrderPromoted": { "const": false },
    "RequiredTargetCount": { "type": "integer", "minimum": 0 },
    "EvidenceReadyCount": { "type": "integer", "minimum": 0 },
    "AllRequiredEvidenceReady": { "type": "boolean" },
    "Targets": {
      "type": "array",
      "items": { "$ref": "#/$defs/targetStatus" }
    },
    "CandidateFieldMap": {
      "type": "array",
      "items": { "$ref": "#/$defs/fieldMap" }
    },
    "DescriptorRecordIndexProof": { "$ref": "#/$defs/descriptorRecordIndexProof" },
    "DescriptorHelperArgumentUseProof": { "$ref": "#/$defs/descriptorHelperArgumentUseProof" },
    "NextAction": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    },
    "targetStatus": {
      "type": "object",
      "required": [
        "Key",
        "ReportPath",
        "Exists",
        "FunctionEntry",
        "DecompileCompleted",
        "RequiredCalls",
        "MissingCalls",
        "RequiredDataRefs",
        "MissingDataRefs",
        "RequiredTerms",
        "MissingTerms",
        "EvidenceReady",
        "EvidenceRole",
        "Error"
      ],
      "properties": {
        "Key": { "type": "string", "minLength": 1 },
        "ReportPath": { "type": "string" },
        "Exists": { "type": "boolean" },
        "FunctionEntry": { "type": "string" },
        "DecompileCompleted": { "type": "boolean" },
        "RequiredCalls": { "$ref": "#/$defs/stringList" },
        "MissingCalls": { "$ref": "#/$defs/stringList" },
        "RequiredDataRefs": { "$ref": "#/$defs/stringList" },
        "MissingDataRefs": { "$ref": "#/$defs/stringList" },
        "RequiredTerms": { "$ref": "#/$defs/stringList" },
        "MissingTerms": { "$ref": "#/$defs/stringList" },
        "EvidenceReady": { "type": "boolean" },
        "EvidenceRole": { "type": "string" },
        "Error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "fieldMap": {
      "type": "object",
      "required": ["Field", "Evidence", "EvidenceTargets"],
      "properties": {
        "Field": { "type": "string", "minLength": 1 },
        "DataAddress": { "type": "string" },
        "PromotionStatus": { "enum": ["candidate-only"] },
        "StaticTableOffsetBytes": { "type": "integer", "minimum": 0 },
        "StaticTableStrideBytes": { "type": "integer", "minimum": 1 },
        "StreamDescriptorRecordStatus": { "type": "string", "minLength": 1 },
        "Evidence": { "type": "string", "minLength": 1 },
        "EvidenceTargets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "descriptorRecordIndexProof": {
      "type": "object",
      "required": [
        "CandidateOnly",
        "FieldOrderPromoted",
        "ParserExportPromotionAllowed",
        "RecordWidthBytes",
        "CandidateIndexByteOffset",
        "CandidateRecordIndexMapped",
        "RemainingUnmappedByteOffsets",
        "RequiredEvidenceCount",
        "PassedEvidenceCount",
        "Checks",
        "BlockerCount",
        "Blockers",
        "Interpretation"
      ],
      "properties": {
        "CandidateOnly": { "const": true },
        "FieldOrderPromoted": { "const": false },
        "ParserExportPromotionAllowed": { "const": false },
        "RecordWidthBytes": { "const": 4 },
        "CandidateIndexByteOffset": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "CandidateRecordIndexMapped": { "type": "boolean" },
        "RemainingUnmappedByteOffsets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "RequiredEvidenceCount": { "type": "integer", "minimum": 0 },
        "PassedEvidenceCount": { "type": "integer", "minimum": 0 },
        "Checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptorRecordIndexCheck" }
        },
        "BlockerCount": { "type": "integer", "minimum": 0 },
        "Blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "Interpretation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "descriptorRecordIndexCheck": {
      "type": "object",
      "required": [
        "Key",
        "TargetKey",
        "ReportPath",
        "DecompileCompleted",
        "RequiredTerms",
        "MissingTerms",
        "Evidence",
        "Passed",
        "Error"
      ],
      "properties": {
        "Key": { "type": "string", "minLength": 1 },
        "TargetKey": { "type": "string", "minLength": 1 },
        "ReportPath": { "type": "string" },
        "DecompileCompleted": { "type": "boolean" },
        "RequiredTerms": { "$ref": "#/$defs/stringList" },
        "MissingTerms": { "$ref": "#/$defs/stringList" },
        "Evidence": { "type": "string", "minLength": 1 },
        "Passed": { "type": "boolean" },
        "Error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "descriptorHelperArgumentUseProof": {
      "type": "object",
      "required": [
        "CandidateOnly",
        "FieldOrderPromoted",
        "ParserExportPromotionAllowed",
        "HelperArgumentWidthBytes",
        "CandidateIndexByteOffset",
        "CandidateHelperLookupIgnoredByteOffsets",
        "CandidateSignGuardByteOffsets",
        "HelperLookupHighBytesUsed",
        "HelperLookupHighBytesProvenUnused",
        "RequiredEvidenceCount",
        "PassedEvidenceCount",
        "Checks",
        "BlockerCount",
        "Blockers",
        "Interpretation"
      ],
      "properties": {
        "CandidateOnly": { "const": true },
        "FieldOrderPromoted": { "const": false },
        "ParserExportPromotionAllowed": { "const": false },
        "HelperArgumentWidthBytes": { "const": 4 },
        "CandidateIndexByteOffset": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "CandidateHelperLookupIgnoredByteOffsets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "CandidateSignGuardByteOffsets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "HelperLookupHighBytesUsed": { "type": "boolean" },
        "HelperLookupHighBytesProvenUnused": { "type": "boolean" },
        "RequiredEvidenceCount": { "type": "integer", "minimum": 0 },
        "PassedEvidenceCount": { "type": "integer", "minimum": 0 },
        "Checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptorHelperArgumentUseCheck" }
        },
        "BlockerCount": { "type": "integer", "minimum": 0 },
        "Blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "Interpretation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "descriptorHelperArgumentUseCheck": {
      "type": "object",
      "required": [
        "Key",
        "TargetKey",
        "ReportPath",
        "DecompileCompleted",
        "RequiredTerms",
        "MissingTerms",
        "ForbiddenHighByteTerms",
        "PresentForbiddenHighByteTerms",
        "Evidence",
        "Passed",
        "Error"
      ],
      "properties": {
        "Key": { "type": "string", "minLength": 1 },
        "TargetKey": { "type": "string", "minLength": 1 },
        "ReportPath": { "type": "string" },
        "DecompileCompleted": { "type": "boolean" },
        "RequiredTerms": { "$ref": "#/$defs/stringList" },
        "MissingTerms": { "$ref": "#/$defs/stringList" },
        "ForbiddenHighByteTerms": { "$ref": "#/$defs/stringList" },
        "PresentForbiddenHighByteTerms": { "$ref": "#/$defs/stringList" },
        "Evidence": { "type": "string", "minLength": 1 },
        "Passed": { "type": "boolean" },
        "Error": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
