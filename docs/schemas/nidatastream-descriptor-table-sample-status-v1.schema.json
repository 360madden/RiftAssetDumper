{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rift-modding.local/schemas/nidatastream-descriptor-table-sample-status-v1.schema.json",
  "title": "NiDataStream descriptor table sample status",
  "type": "object",
  "required": [
    "SchemaVersion",
    "CandidateOnly",
    "FieldOrderPromoted",
    "ParserExportPromotionAllowed",
    "Status"
  ],
  "properties": {
    "SchemaVersion": { "const": "nidatastream-descriptor-table-sample-status/v1" },
    "CandidateOnly": { "const": true },
    "FieldOrderPromoted": { "const": false },
    "ParserExportPromotionAllowed": { "const": false },
    "Status": { "$ref": "#/$defs/descriptorTableSampleStatus" }
  },
  "additionalProperties": false,
  "$defs": {
    "descriptorTableSampleStatus": {
      "type": "object",
      "required": [
        "CandidateOnly",
        "FieldOrderPromoted",
        "ParserExportPromotionAllowed",
        "Path",
        "Exists",
        "SchemaVersion",
        "ReportCandidateOnly",
        "ReportFieldOrderPromoted",
        "ReportParserExportPromotionAllowed",
        "IndexCount",
        "FieldCount",
        "RowCount",
        "NonzeroRowCount",
        "ErrorRowCount",
        "AllRowsZero",
        "SampleReportReady",
        "StreamSemanticsExplained",
        "RowsByField",
        "RowsByIndex",
        "Error",
        "BlockerCount",
        "Blockers",
        "Interpretation"
      ],
      "properties": {
        "CandidateOnly": { "const": true },
        "FieldOrderPromoted": { "const": false },
        "ParserExportPromotionAllowed": { "const": false },
        "Path": { "type": "string", "minLength": 1 },
        "Exists": { "type": "boolean" },
        "SchemaVersion": { "type": "string" },
        "ReportCandidateOnly": { "type": "boolean" },
        "ReportFieldOrderPromoted": { "type": "boolean" },
        "ReportParserExportPromotionAllowed": { "type": "boolean" },
        "IndexCount": { "type": "integer", "minimum": 0 },
        "FieldCount": { "type": "integer", "minimum": 0 },
        "RowCount": { "type": "integer", "minimum": 0 },
        "NonzeroRowCount": { "type": "integer", "minimum": 0 },
        "ErrorRowCount": { "type": "integer", "minimum": 0 },
        "AllRowsZero": { "type": "boolean" },
        "SampleReportReady": { "type": "boolean" },
        "StreamSemanticsExplained": { "const": false },
        "RowsByField": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptorTableSampleFieldSummary" }
        },
        "RowsByIndex": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptorTableSampleIndexSummary" }
        },
        "Error": { "type": "string" },
        "BlockerCount": { "type": "integer", "minimum": 0 },
        "Blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "Interpretation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "descriptorTableSampleFieldSummary": {
      "type": "object",
      "required": ["Field", "RowCount", "NonzeroRowCount", "AllRowsZero", "Indices"],
      "properties": {
        "Field": { "type": "string" },
        "RowCount": { "type": "integer", "minimum": 0 },
        "NonzeroRowCount": { "type": "integer", "minimum": 0 },
        "AllRowsZero": { "type": "boolean" },
        "Indices": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "descriptorTableSampleIndexSummary": {
      "type": "object",
      "required": ["IndexHex", "RowCount", "NonzeroRowCount", "AllRowsZero", "Fields"],
      "properties": {
        "IndexHex": { "type": "string" },
        "RowCount": { "type": "integer", "minimum": 0 },
        "NonzeroRowCount": { "type": "integer", "minimum": 0 },
        "AllRowsZero": { "type": "boolean" },
        "Fields": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
