{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.riftassetdumper/schemas/nidatastream-descriptor-sample-compare-v1.schema.json",
  "title": "NiDataStream descriptor/sample-byte comparison v1",
  "description": "Candidate-only comparison emitted by `python scripts/rift_workflow.py nidatastream-descriptor-sample-compare --list-json`.",
  "type": "object",
  "required": [
    "SchemaVersion",
    "CandidateOnly",
    "ParserExportPromotionAllowed",
    "FieldOrderPromoted",
    "DescriptorAndSampleEvidenceReady",
    "DescriptorStatus",
    "LayoutReportStatus",
    "SampleCorpusStatus",
    "SampleByteSummary",
    "DescriptorByteOrderProof",
    "DescriptorRecordByteSummary",
    "DescriptorRecordIndexProof",
    "DescriptorHelperArgumentUseProof",
    "DescriptorRecordByteRoleCandidates",
    "DescriptorRecordPatternMatrix",
    "DescriptorSampleContextCorrelation",
    "DescriptorSemanticFeasibility",
    "CandidateFieldMap",
    "PromotionGateBlockers",
    "BlockerCount",
    "Blockers",
    "Decision",
    "NextAction"
  ],
  "properties": {
    "SchemaVersion": { "const": "nidatastream-descriptor-sample-compare/v1" },
    "CandidateOnly": { "const": true },
    "ParserExportPromotionAllowed": { "const": false },
    "FieldOrderPromoted": { "const": false },
    "DescriptorAndSampleEvidenceReady": { "type": "boolean" },
    "DescriptorStatus": { "$ref": "#/$defs/descriptorStatus" },
    "LayoutReportStatus": { "$ref": "#/$defs/layoutReportStatus" },
    "SampleCorpusStatus": { "$ref": "#/$defs/sampleCorpusStatus" },
    "SampleByteSummary": { "$ref": "#/$defs/sampleByteSummary" },
    "DescriptorByteOrderProof": { "$ref": "#/$defs/descriptorByteOrderProof" },
    "DescriptorRecordByteSummary": { "$ref": "#/$defs/descriptorRecordByteSummary" },
    "DescriptorRecordIndexProof": { "$ref": "#/$defs/descriptorRecordIndexProof" },
    "DescriptorHelperArgumentUseProof": { "$ref": "#/$defs/descriptorHelperArgumentUseProof" },
    "DescriptorRecordByteRoleCandidates": { "$ref": "#/$defs/descriptorRecordByteRoleCandidates" },
    "DescriptorRecordPatternMatrix": { "$ref": "#/$defs/descriptorRecordPatternMatrix" },
    "DescriptorSampleContextCorrelation": { "$ref": "#/$defs/descriptorSampleContextCorrelation" },
    "DescriptorSemanticFeasibility": { "$ref": "#/$defs/descriptorSemanticFeasibility" },
    "CandidateFieldMap": {
      "type": "array",
      "items": { "$ref": "#/$defs/fieldMap" }
    },
    "PromotionGateBlockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "BlockerCount": { "type": "integer", "minimum": 0 },
    "Blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "Decision": { "type": "string", "minLength": 1 },
    "NextAction": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    },
    "counterValue": {
      "anyOf": [
        { "type": "integer" },
        { "type": "number" },
        { "type": "string" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "counterRow": {
      "type": "object",
      "required": ["Value", "Count"],
      "properties": {
        "Value": { "$ref": "#/$defs/counterValue" },
        "Count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "stringCounterRow": {
      "type": "object",
      "required": ["Value", "Count"],
      "properties": {
        "Value": { "type": "string" },
        "Count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "descriptorStatus": {
      "type": "object",
      "required": [
        "SchemaVersion",
        "RequiredTargetCount",
        "EvidenceReadyCount",
        "AllRequiredEvidenceReady",
        "FieldOrderPromoted"
      ],
      "properties": {
        "SchemaVersion": { "const": "nidatastream-descriptor-proof-status/v1" },
        "RequiredTargetCount": { "type": "integer", "minimum": 0 },
        "EvidenceReadyCount": { "type": "integer", "minimum": 0 },
        "AllRequiredEvidenceReady": { "type": "boolean" },
        "FieldOrderPromoted": { "const": false }
      },
      "additionalProperties": false
    },
    "layoutReportStatus": {
      "type": "object",
      "required": [
        "Path",
        "Exists",
        "Schema",
        "FilesScanned",
        "FilesParsed",
        "NiDataStreamBlocks",
        "GhidraStyleLayoutValidBlocks",
        "LegacyOffsetShiftedBlocks",
        "AllBlocksGhidraStyleValid",
        "Error"
      ],
      "properties": {
        "Path": { "type": "string", "minLength": 1 },
        "Exists": { "type": "boolean" },
        "Schema": { "type": "string" },
        "FilesScanned": { "type": "integer", "minimum": 0 },
        "FilesParsed": { "type": "integer", "minimum": 0 },
        "NiDataStreamBlocks": { "type": "integer", "minimum": 0 },
        "GhidraStyleLayoutValidBlocks": { "type": "integer", "minimum": 0 },
        "LegacyOffsetShiftedBlocks": { "type": "integer", "minimum": 0 },
        "AllBlocksGhidraStyleValid": { "type": "boolean" },
        "Error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sampleByteSummary": {
      "type": "object",
      "required": ["CheckCount", "PassedCount", "AllExpectedValuesUniform", "Checks"],
      "properties": {
        "CheckCount": { "type": "integer", "minimum": 0 },
        "PassedCount": { "type": "integer", "minimum": 0 },
        "AllExpectedValuesUniform": { "type": "boolean" },
        "Checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/sampleByteCheck" }
        }
      },
      "additionalProperties": false
    },
    "sampleCorpusStatus": {
      "type": "object",
      "required": [
        "Root",
        "MaxFiles",
        "FilesScanned",
        "FilesParsed",
        "FilesWithNiDataStreamBlocks",
        "ParseErrorCount",
        "ShiftedSampleCount",
        "WarningCount"
      ],
      "properties": {
        "Root": { "type": "string" },
        "MaxFiles": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "FilesScanned": { "type": "integer", "minimum": 0 },
        "FilesParsed": { "type": "integer", "minimum": 0 },
        "FilesWithNiDataStreamBlocks": { "type": "integer", "minimum": 0 },
        "ParseErrorCount": { "type": "integer", "minimum": 0 },
        "ShiftedSampleCount": { "type": "integer", "minimum": 0 },
        "WarningCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "sampleByteCheck": {
      "type": "object",
      "required": [
        "Key",
        "Source",
        "ExpectedValue",
        "ObservedValue",
        "ObservedInteger",
        "ObservedCount",
        "ExpectedBlockCount",
        "RowsSeen",
        "Uniform",
        "MatchesExpected",
        "Meaning"
      ],
      "properties": {
        "Key": { "type": "string", "minLength": 1 },
        "Source": { "type": "string", "minLength": 1 },
        "ExpectedValue": { "type": "integer" },
        "ObservedValue": { "$ref": "#/$defs/counterValue" },
        "ObservedInteger": {
          "anyOf": [{ "type": "integer" }, { "type": "null" }]
        },
        "ObservedCount": { "type": "integer", "minimum": 0 },
        "ExpectedBlockCount": { "type": "integer", "minimum": 0 },
        "RowsSeen": { "type": "integer", "minimum": 0 },
        "Uniform": { "type": "boolean" },
        "MatchesExpected": { "type": "boolean" },
        "Meaning": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "descriptorByteOrderProof": {
      "type": "object",
      "required": [
        "CandidateOnly",
        "FieldOrderPromoted",
        "CheckCount",
        "PassedCount",
        "AllExpectedFieldsUniform",
        "Checks",
        "TopFirstPairRecordBytes",
        "TopFirstDescriptorRecordBytes",
        "Interpretation"
      ],
      "properties": {
        "CandidateOnly": { "const": true },
        "FieldOrderPromoted": { "const": false },
        "CheckCount": { "type": "integer", "minimum": 0 },
        "PassedCount": { "type": "integer", "minimum": 0 },
        "AllExpectedFieldsUniform": { "type": "boolean" },
        "Checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptorByteOrderCheck" }
        },
        "TopFirstPairRecordBytes": {
          "type": "array",
          "items": { "$ref": "#/$defs/counterRow" }
        },
        "TopFirstDescriptorRecordBytes": {
          "type": "array",
          "items": { "$ref": "#/$defs/counterRow" }
        },
        "Interpretation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "descriptorByteOrderCheck": {
      "type": "object",
      "required": [
        "Key",
        "Source",
        "ExpectedValue",
        "ObservedValue",
        "ObservedInteger",
        "ObservedCount",
        "ExpectedBlockCount",
        "RowsSeen",
        "Uniform",
        "MatchesExpected",
        "Meaning",
        "OffsetBytes",
        "WidthBytes",
        "Encoding"
      ],
      "properties": {
        "Key": { "type": "string", "minLength": 1 },
        "Source": { "type": "string", "minLength": 1 },
        "ExpectedValue": { "type": "integer" },
        "ObservedValue": { "$ref": "#/$defs/counterValue" },
        "ObservedInteger": {
          "anyOf": [{ "type": "integer" }, { "type": "null" }]
        },
        "ObservedCount": { "type": "integer", "minimum": 0 },
        "ExpectedBlockCount": { "type": "integer", "minimum": 0 },
        "RowsSeen": { "type": "integer", "minimum": 0 },
        "Uniform": { "type": "boolean" },
        "MatchesExpected": { "type": "boolean" },
        "Meaning": { "type": "string", "minLength": 1 },
        "OffsetBytes": { "type": "integer", "minimum": 0 },
        "WidthBytes": { "type": "integer", "minimum": 0 },
        "Encoding": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "descriptorRecordByteSummary": {
      "type": "object",
      "required": [
        "CandidateOnly",
        "FieldOrderPromoted",
        "Source",
        "RecordPatternCount",
        "ObservedRecordCount",
        "MalformedRecordCount",
        "RecordWidthBytes",
        "ByteOffsets",
        "Interpretation"
      ],
      "properties": {
        "CandidateOnly": { "const": true },
        "FieldOrderPromoted": { "const": false },
        "Source": { "const": "TopFirstDescriptorRecordBytes" },
        "RecordPatternCount": { "type": "integer", "minimum": 0 },
        "ObservedRecordCount": { "type": "integer", "minimum": 0 },
        "MalformedRecordCount": { "type": "integer", "minimum": 0 },
        "RecordWidthBytes": { "type": "integer", "minimum": 0 },
        "ByteOffsets": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptorRecordByteOffset" }
        },
        "Interpretation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "descriptorRecordByteOffset": {
      "type": "object",
      "required": ["OffsetBytes", "UniqueValueCount", "TopValues"],
      "properties": {
        "OffsetBytes": { "type": "integer", "minimum": 0 },
        "UniqueValueCount": { "type": "integer", "minimum": 0 },
        "TopValues": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptorRecordByteValue" }
        }
      },
      "additionalProperties": false
    },
    "descriptorRecordByteValue": {
      "type": "object",
      "required": ["ValueHex", "ValueInteger", "Count"],
      "properties": {
        "ValueHex": { "type": "string", "pattern": "^[0-9a-f]{2}$" },
        "ValueInteger": { "type": "integer", "minimum": 0, "maximum": 255 },
        "Count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "descriptorSemanticFeasibility": {
      "type": "object",
      "required": [
        "CandidateOnly",
        "FieldOrderPromoted",
        "ParserExportPromotionAllowed",
        "StaticFieldMapReady",
        "DescriptorRecordByteDistributionReady",
        "DescriptorRecordIndexCandidateMapped",
        "DescriptorRecordByteRolesClassified",
        "DescriptorHelperLookupHighBytesProvenUnused",
        "CandidateIndexByteOffset",
        "CandidatePaddingByteOffsets",
        "CandidateHelperLookupIgnoredByteOffsets",
        "CandidateSignGuardByteOffsets",
        "RemainingUnmappedRecordByteOffsets",
        "StaticFieldMapOffsetCount",
        "DescriptorRecordByteOffsetCount",
        "DescriptorRecordWidthBytes",
        "StreamDescriptorRecordMapped",
        "StreamDescriptorRecordMappedCount",
        "SemanticMappingReady",
        "OffsetComparisonRows",
        "BlockerCount",
        "Blockers",
        "Interpretation",
        "NextAction"
      ],
      "properties": {
        "CandidateOnly": { "const": true },
        "FieldOrderPromoted": { "const": false },
        "ParserExportPromotionAllowed": { "const": false },
        "StaticFieldMapReady": { "type": "boolean" },
        "DescriptorRecordByteDistributionReady": { "type": "boolean" },
        "DescriptorRecordIndexCandidateMapped": { "type": "boolean" },
        "DescriptorRecordByteRolesClassified": { "type": "boolean" },
        "DescriptorHelperLookupHighBytesProvenUnused": { "type": "boolean" },
        "CandidateIndexByteOffset": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "CandidatePaddingByteOffsets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "CandidateHelperLookupIgnoredByteOffsets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "CandidateSignGuardByteOffsets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "RemainingUnmappedRecordByteOffsets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "StaticFieldMapOffsetCount": { "type": "integer", "minimum": 0 },
        "DescriptorRecordByteOffsetCount": { "type": "integer", "minimum": 0 },
        "DescriptorRecordWidthBytes": { "type": "integer", "minimum": 0 },
        "StreamDescriptorRecordMapped": { "type": "boolean" },
        "StreamDescriptorRecordMappedCount": { "type": "integer", "minimum": 0 },
        "SemanticMappingReady": { "const": false },
        "OffsetComparisonRows": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptorSemanticOffsetComparison" }
        },
        "BlockerCount": { "type": "integer", "minimum": 0 },
        "Blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "Interpretation": { "type": "string", "minLength": 1 },
        "NextAction": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "descriptorSemanticOffsetComparison": {
      "type": "object",
      "required": [
        "Field",
        "StaticTableOffsetBytes",
        "StaticTableStrideBytes",
        "StreamDescriptorRecordStatus",
        "CandidateRecordByteOffsets",
        "RecordByteOffsetMapped",
        "MappingDecision"
      ],
      "properties": {
        "Field": { "type": "string", "minLength": 1 },
        "StaticTableOffsetBytes": { "type": "integer", "minimum": 0 },
        "StaticTableStrideBytes": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "StreamDescriptorRecordStatus": { "type": "string", "minLength": 1 },
        "CandidateRecordByteOffsets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "RecordByteOffsetMapped": { "type": "boolean" },
        "MappingDecision": {
          "enum": [
            "mapped-candidate",
            "selected-by-record-byte-0-index-candidate",
            "unmapped-static-table-offset-not-stream-byte-offset"
          ]
        }
      },
      "additionalProperties": false
    },
    "descriptorRecordByteRoleCandidates": {
      "type": "object",
      "required": [
        "CandidateOnly",
        "FieldOrderPromoted",
        "ParserExportPromotionAllowed",
        "RecordWidthBytes",
        "ObservedRecordCount",
        "ClassifiedByteCount",
        "CandidateSemanticByteOffsets",
        "CandidatePaddingByteOffsets",
        "RemainingUnmappedByteOffsets",
        "AllBytesClassified",
        "Rows",
        "BlockerCount",
        "Blockers",
        "Interpretation"
      ],
      "properties": {
        "CandidateOnly": { "const": true },
        "FieldOrderPromoted": { "const": false },
        "ParserExportPromotionAllowed": { "const": false },
        "RecordWidthBytes": { "type": "integer", "minimum": 0 },
        "ObservedRecordCount": { "type": "integer", "minimum": 0 },
        "ClassifiedByteCount": { "type": "integer", "minimum": 0 },
        "CandidateSemanticByteOffsets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "CandidatePaddingByteOffsets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "RemainingUnmappedByteOffsets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "AllBytesClassified": { "type": "boolean" },
        "Rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptorRecordByteRoleRow" }
        },
        "BlockerCount": { "type": "integer", "minimum": 0 },
        "Blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "Interpretation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "descriptorRecordByteRoleRow": {
      "type": "object",
      "required": [
        "OffsetBytes",
        "CandidateRole",
        "Classification",
        "UniqueValueCount",
        "ObservedRecordCount",
        "TopValues",
        "BlocksSemanticMapping",
        "Evidence"
      ],
      "properties": {
        "OffsetBytes": { "type": "integer", "minimum": 0 },
        "CandidateRole": {
          "enum": [
            "static-descriptor-table-index",
            "zero-padding-or-reserved",
            "unmapped-variable-byte"
          ]
        },
        "Classification": {
          "enum": [
            "ghidra-record-index-proof",
            "uniform-zero-candidate",
            "variable-unmapped"
          ]
        },
        "UniqueValueCount": { "type": "integer", "minimum": 0 },
        "ObservedRecordCount": { "type": "integer", "minimum": 0 },
        "TopValues": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptorRecordByteValue" }
        },
        "BlocksSemanticMapping": { "type": "boolean" },
        "Evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "descriptorRecordPatternMatrix": {
      "type": "object",
      "required": [
        "CandidateOnly",
        "FieldOrderPromoted",
        "ParserExportPromotionAllowed",
        "Source",
        "RecordPatternCount",
        "ObservedRecordCount",
        "MalformedRecordCount",
        "CandidateIndexByteOffset",
        "CandidateHelperLookupIgnoredByteOffsets",
        "CandidateSignGuardByteOffsets",
        "RemainingUnmappedByteOffsets",
        "Rows",
        "BlockerCount",
        "Blockers",
        "Interpretation"
      ],
      "properties": {
        "CandidateOnly": { "const": true },
        "FieldOrderPromoted": { "const": false },
        "ParserExportPromotionAllowed": { "const": false },
        "Source": { "const": "TopFirstDescriptorRecordBytes" },
        "RecordPatternCount": { "type": "integer", "minimum": 0 },
        "ObservedRecordCount": { "type": "integer", "minimum": 0 },
        "MalformedRecordCount": { "type": "integer", "minimum": 0 },
        "CandidateIndexByteOffset": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "CandidateHelperLookupIgnoredByteOffsets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "CandidateSignGuardByteOffsets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "RemainingUnmappedByteOffsets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "Rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptorRecordPatternRow" }
        },
        "BlockerCount": { "type": "integer", "minimum": 0 },
        "Blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "Interpretation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "descriptorRecordPatternRow": {
      "type": "object",
      "required": [
        "PatternRank",
        "RecordHex",
        "Count",
        "RecordWidthBytes",
        "CandidateIndexByte",
        "CandidateHelperLookupIgnoredBytes",
        "CandidateSignGuardBytes",
        "RemainingUnmappedBytes"
      ],
      "properties": {
        "PatternRank": { "type": "integer", "minimum": 1 },
        "RecordHex": { "type": "string", "pattern": "^[0-9a-f]{2}(?: [0-9a-f]{2})*$" },
        "Count": { "type": "integer", "minimum": 0 },
        "RecordWidthBytes": { "type": "integer", "minimum": 0 },
        "CandidateIndexByte": {
          "anyOf": [{ "$ref": "#/$defs/descriptorRecordPatternValue" }, { "type": "null" }]
        },
        "CandidateHelperLookupIgnoredBytes": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptorRecordPatternValue" }
        },
        "CandidateSignGuardBytes": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptorRecordPatternValue" }
        },
        "RemainingUnmappedBytes": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptorRecordPatternValue" }
        }
      },
      "additionalProperties": false
    },
    "descriptorRecordPatternValue": {
      "type": "object",
      "required": ["OffsetBytes", "ValueHex", "ValueInteger"],
      "properties": {
        "OffsetBytes": { "type": "integer", "minimum": 0 },
        "ValueHex": { "type": "string", "pattern": "^[0-9a-f]{2}$" },
        "ValueInteger": { "type": "integer", "minimum": 0, "maximum": 255 }
      },
      "additionalProperties": false
    },
    "descriptorSampleContextCorrelation": {
      "type": "object",
      "required": [
        "CandidateOnly",
        "FieldOrderPromoted",
        "ParserExportPromotionAllowed",
        "Source",
        "SampleCount",
        "SamplesWithDescriptorRecord",
        "SamplesWithPairRecord",
        "MalformedDescriptorRecordCount",
        "CorrelationReady",
        "RemainingUnmappedByteOffsets",
        "DescriptorPatternCount",
        "Rows",
        "BlockerCount",
        "Blockers",
        "Interpretation"
      ],
      "properties": {
        "CandidateOnly": { "const": true },
        "FieldOrderPromoted": { "const": false },
        "ParserExportPromotionAllowed": { "const": false },
        "Source": { "const": "ShiftedSamples" },
        "SampleCount": { "type": "integer", "minimum": 0 },
        "SamplesWithDescriptorRecord": { "type": "integer", "minimum": 0 },
        "SamplesWithPairRecord": { "type": "integer", "minimum": 0 },
        "MalformedDescriptorRecordCount": { "type": "integer", "minimum": 0 },
        "CorrelationReady": { "type": "boolean" },
        "RemainingUnmappedByteOffsets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "DescriptorPatternCount": { "type": "integer", "minimum": 0 },
        "Rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptorSampleContextCorrelationRow" }
        },
        "BlockerCount": { "type": "integer", "minimum": 0 },
        "Blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "Interpretation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "descriptorSampleContextCorrelationRow": {
      "type": "object",
      "required": [
        "DescriptorRecordHex",
        "SampleCount",
        "CandidateIndexByte",
        "RemainingUnmappedBytes",
        "PairRecordPatternCount",
        "TopPairRecordBytes",
        "UsageValueCount",
        "TopUsageValues",
        "AccessValueCount",
        "TopAccessValues",
        "TypeNameValueCount",
        "TopTypeNames"
      ],
      "properties": {
        "DescriptorRecordHex": { "type": "string", "pattern": "^[0-9a-f]{2}(?: [0-9a-f]{2})*$" },
        "SampleCount": { "type": "integer", "minimum": 0 },
        "CandidateIndexByte": {
          "anyOf": [{ "$ref": "#/$defs/descriptorRecordPatternValue" }, { "type": "null" }]
        },
        "RemainingUnmappedBytes": {
          "type": "array",
          "items": { "$ref": "#/$defs/descriptorRecordPatternValue" }
        },
        "PairRecordPatternCount": { "type": "integer", "minimum": 0 },
        "TopPairRecordBytes": {
          "type": "array",
