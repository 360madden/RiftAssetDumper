{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.riftassetdumper/schemas/nidatastream-promotion-status-v1.schema.json",
  "title": "NiDataStream parser/export promotion status v1",
  "description": "Machine-readable post-Stage-18 NiDataStream promotion gate status emitted by `python scripts/rift_workflow.py nidatastream-promotion-status --list-json`.",
  "type": "object",
  "required": [
    "SchemaVersion",
    "CandidateOnly",
    "HistoricalStage",
    "CurrentLane",
    "FunctionSiteTargetStatus",
    "DescriptorReportStatus",
    "LayoutReportStatus",
    "DescriptorSampleCompareStatus",
    "PairingImpactStatus",
    "ParserExportPromotionAllowed",
    "BlockerCount",
    "Blockers",
    "Gates",
    "NextAction"
  ],
  "properties": {
    "SchemaVersion": { "const": "nidatastream-promotion-status/v1" },
    "CandidateOnly": { "const": true },
    "HistoricalStage": { "const": "Stage 18 complete" },
    "CurrentLane": { "type": "string", "minLength": 1 },
    "FunctionSiteTargetStatus": { "$ref": "#/$defs/functionSiteTargetStatus" },
    "DescriptorReportStatus": { "$ref": "#/$defs/descriptorReportStatus" },
    "LayoutReportStatus": { "$ref": "#/$defs/layoutReportStatus" },
    "DescriptorSampleCompareStatus": { "$ref": "#/$defs/descriptorSampleCompareStatus" },
    "PairingImpactStatus": { "$ref": "#/$defs/pairingImpactStatus" },
    "ParserExportPromotionAllowed": { "const": false },
    "BlockerCount": { "type": "integer", "minimum": 0 },
    "Blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "Gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    },
    "NextAction": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "functionSiteTargetStatus": {
      "type": "object",
      "required": ["TargetCount", "EvidenceReadyCount", "EvidenceReady"],
      "properties": {
        "TargetCount": { "type": "integer", "minimum": 0 },
        "EvidenceReadyCount": { "type": "integer", "minimum": 0 },
        "EvidenceReady": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "layoutReportStatus": {
      "type": "object",
      "required": [
        "Path",
        "Exists",
        "Schema",
        "FilesScanned",
        "FilesParsed",
        "NiDataStreamBlocks",
        "GhidraStyleLayoutValidBlocks",
        "LegacyOffsetShiftedBlocks",
        "AllBlocksGhidraStyleValid",
        "Error"
      ],
      "properties": {
        "Path": { "type": "string", "minLength": 1 },
        "Exists": { "type": "boolean" },
        "Schema": { "type": "string" },
        "FilesScanned": { "type": "integer", "minimum": 0 },
        "FilesParsed": { "type": "integer", "minimum": 0 },
        "NiDataStreamBlocks": { "type": "integer", "minimum": 0 },
        "GhidraStyleLayoutValidBlocks": { "type": "integer", "minimum": 0 },
        "LegacyOffsetShiftedBlocks": { "type": "integer", "minimum": 0 },
        "AllBlocksGhidraStyleValid": { "type": "boolean" },
        "Error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "descriptorReportStatus": {
      "type": "object",
      "required": [
        "SchemaVersion",
        "RequiredTargetCount",
        "EvidenceReadyCount",
        "AllRequiredEvidenceReady",
        "FieldOrderPromoted"
      ],
      "properties": {
        "SchemaVersion": { "const": "nidatastream-descriptor-proof-status/v1" },
        "RequiredTargetCount": { "type": "integer", "minimum": 0 },
        "EvidenceReadyCount": { "type": "integer", "minimum": 0 },
        "AllRequiredEvidenceReady": { "type": "boolean" },
        "FieldOrderPromoted": { "const": false }
      },
      "additionalProperties": false
    },
    "descriptorSampleCompareStatus": {
      "type": "object",
      "required": [
        "SampleCorpusRoot",
        "FilesScanned",
        "FilesParsed",
        "ParseErrorCount",
        "SampleByteCheckCount",
        "SampleBytePassedCount",
        "AllSampleBytesUniform",
        "ByteOrderCheckCount",
        "ByteOrderPassedCount",
        "AllByteOrderFieldsUniform",
        "DescriptorAndSampleEvidenceReady"
      ],
      "properties": {
        "SampleCorpusRoot": { "type": "string" },
        "FilesScanned": { "type": "integer", "minimum": 0 },
        "FilesParsed": { "type": "integer", "minimum": 0 },
        "ParseErrorCount": { "type": "integer", "minimum": 0 },
        "SampleByteCheckCount": { "type": "integer", "minimum": 0 },
        "SampleBytePassedCount": { "type": "integer", "minimum": 0 },
        "AllSampleBytesUniform": { "type": "boolean" },
        "ByteOrderCheckCount": { "type": "integer", "minimum": 0 },
        "ByteOrderPassedCount": { "type": "integer", "minimum": 0 },
        "AllByteOrderFieldsUniform": { "type": "boolean" },
        "DescriptorAndSampleEvidenceReady": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "pairingImpactStatus": {
      "type": "object",
      "required": [
        "Path",
        "Exists",
        "SchemaVersion",
        "GhidraOnlyGroups",
        "GhidraOnlyPairingsCovered",
        "GroupedSampleMeshes",
        "CompletePositionNormalUvCandidateGroups",
        "ProbeBackedRanks",
        "RejectedNoiseGroups",
        "GuardBaselinePass",
        "Error"
      ],
      "properties": {
        "Path": { "type": "string", "minLength": 1 },
        "Exists": { "type": "boolean" },
        "SchemaVersion": { "type": "string" },
        "GhidraOnlyGroups": { "type": "integer", "minimum": 0 },
        "GhidraOnlyPairingsCovered": { "type": "integer", "minimum": 0 },
        "GroupedSampleMeshes": { "type": "integer", "minimum": 0 },
        "CompletePositionNormalUvCandidateGroups": { "type": "integer", "minimum": 0 },
        "ProbeBackedRanks": { "type": "integer", "minimum": 0 },
        "RejectedNoiseGroups": { "type": "integer", "minimum": 0 },
        "GuardBaselinePass": { "type": "boolean" },
        "Error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["Key", "State", "BlocksPromotion", "RequiredProof", "Evidence", "Command"],
      "properties": {
        "Key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "State": { "enum": ["pass", "candidate", "blocked"] },
        "BlocksPromotion": { "type": "boolean" },
        "RequiredProof": { "type": "string", "minLength": 1 },
        "Evidence": { "type": "string", "minLength": 1 },
        "Command": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
