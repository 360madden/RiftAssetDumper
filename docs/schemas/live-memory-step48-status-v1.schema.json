{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rift-modding.local/schemas/live-memory-step48-status-v1.schema.json",
  "title": "50-step plan Step 48 live scan status",
  "type": "object",
  "required": [
    "SchemaVersion",
    "CandidateOnly",
    "Step",
    "Provider",
    "PatternLabel",
    "PatternHex",
    "LiveReadApproved",
    "LiveReadExecuted",
    "Found",
    "ProcessName",
    "OutputKind",
    "ExitCode",
    "ModuleName",
    "ModuleFileName",
    "RelativeOffsetHex",
    "Address",
    "ContextBytesHex",
    "GeneratedReportPolicy",
    "ParserExportPromotionAllowed",
    "NextStep"
  ],
  "properties": {
    "SchemaVersion": { "const": "live-memory-step48-status/v1" },
    "CandidateOnly": { "const": true },
    "Step": { "const": 48 },
    "Provider": { "const": "RiftReader.Reader" },
    "PatternLabel": { "const": "stage5_step48_at264_index_strip_prefix" },
    "PatternHex": { "const": "00010002000200010003000400050006" },
    "LiveReadApproved": { "type": "boolean" },
    "LiveReadExecuted": { "type": "boolean" },
    "Found": { "type": "boolean" },
    "ProcessName": { "const": "rift_x64" },
    "OutputKind": { "const": "module-pattern-scan" },
    "ExitCode": { "type": "integer" },
    "ModuleName": { "const": "rift_x64.exe" },
    "ModuleFileName": { "const": "%RIFT_LIVE%\\rift_x64.exe" },
    "RelativeOffsetHex": { "type": "string", "pattern": "^0x[0-9A-F]+$" },
    "Address": { "type": "string", "pattern": "^0x[0-9A-F]+$" },
    "ContextBytesHex": { "const": "00010002000200010003000400050006" },
    "GeneratedReportPolicy": { "const": "ignored under Exports/discovery-plan/stage5-live" },
    "ParserExportPromotionAllowed": { "const": false },
    "NextStep": { "const": "Step 49 - scan for position float3 clusters matching mesh bounds" }
  },
  "additionalProperties": false
}
